{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/moizpos-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "MoizPos",
    "Audience": "MoizPosCounter",
    "Key": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },
  "Shop": {
    "Name": "Moiz Mobile & Corporation",
    "Location": "Danwran Lodhran",
    "ContactNumber": "0300 7194095",
    "TimeZone": "Asia/Karachi"
  },
  "Storage": {
    "ProductImageRoot": "content/products",
    "MaxImageBytes": 2097152
  },
  "Backup": {
    "Directory": "backups",
    "RetainDays": 30,
    "RunAtLocalHour": 2
  },
  "Documents": {
    "ShareLinkExpiryDays": 30,
    "PublicBaseUrl": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
