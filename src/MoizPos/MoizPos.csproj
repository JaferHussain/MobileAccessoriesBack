<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The whole backend in one project: Domain, Application, Infrastructure, the Api host and the
    database Migrator. Folders under this project map to the namespaces they always had, so
    MoizPos.Domain.Entities still lives in Domain/Entities.

    LAYERING IS NO LONGER ENFORCED BY PROJECT REFERENCES. Constitution Principle II still requires
    Domain -> nothing, Application -> Domain, Infrastructure -> Application, Api -> both. That rule
    is now enforced by LayeringTests in the test project, which reads each file's namespace and its
    using directives. If you break a layer, that test fails the build the same way a missing
    project reference used to.
  -->
  <PropertyGroup>
    <RootNamespace>MoizPos</RootNamespace>
    <AssemblyName>MoizPos</AssemblyName>
    <UserSecretsId>4b3e51d4-aa5f-4474-bede-a67d60d16031</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- DbUp discovers migrations as embedded resources, so scripts ship inside the assembly. -->
    <EmbeddedResource Include="Migrator\Scripts\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Api host -->
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />

    <!-- Application -->
    <PackageReference Include="FluentValidation" Version="11.9.0" />

    <!-- Infrastructure -->
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
    <PackageReference Include="QuestPDF" Version="2024.3.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.2" />

    <!-- Migrator -->
    <PackageReference Include="dbup-mysql" Version="5.0.41" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.1" />
  </ItemGroup>

</Project>
